---
import Page from '../components/index';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

const SITE = 'https://fromsukong.com';
const TITLE = 'FromSukong | Building in Public — Supakone Kongprapan';
const DESCRIPTION =
  "Link-in-bio for Supakone Kongprapan (@fromsukong) — posting daily, building excited.live, and running the public Road to 85kg challenge. Follow the journey on Instagram, TikTok, YouTube.";
const OG_IMAGE = 'https://fromsukong.com/assets/og-image.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FC5200" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500,
      });
      try {
        if (localStorage.getItem('fs-consent') === 'accepted') {
          gtag('consent', 'update', {'analytics_storage': 'granted'});
        }
      } catch (e) {}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4R5CYWR2M4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4R5CYWR2M4');
    </script>
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={SITE + '/'} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE + '/'} />
    <meta property="og:site_name" content="FromSukong" />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="profile:username" content="fromsukong" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fustat:wght@300;400;500;600;700&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': SITE + '/#person',
          name: 'Supakone Kongprapan',
          alternateName: 'FromSukong',
          url: SITE + '/',
          image: OG_IMAGE,
          jobTitle: 'Software Engineer & Creator',
          description: 'Posting daily and building excited.live. Follow the Road to 85kg challenge.',
          knowsAbout: ['building in public', 'content creation', 'web development', 'AI automation', 'React', 'Astro'],
          email: 'mailto:supakone.kongprapan@gmail.com',
          telephone: '+66622645246',
          sameAs: [
            'https://instagram.com/fromsukong',
            'https://www.youtube.com/channel/UC12xsWSeHKOZHff8W6xPx6g',
            'https://www.threads.com/@fromsukong',
            'https://tiktok.com/@prem_sukong',
            'https://www.facebook.com/fromsukong/',
          ],
        },
        {
          '@type': 'WebSite',
          '@id': SITE + '/#website',
          url: SITE + '/',
          name: 'FromSukong',
          description: 'Posting daily, building excited.live, and running the Road to 85kg challenge.',
          publisher: { '@id': SITE + '/#person' },
        },
        {
          '@type': 'ProfilePage',
          '@id': SITE + '/#page',
          url: SITE + '/',
          mainEntity: { '@id': SITE + '/#person' },
        },
      ],
    })} />
  </head>
  <body>
    <Page client:load />
    <ConsentBanner />
  </body>
</html>
