---
// Home — the Fastwork funnel: centered hero + animated automation demo.
// Shell (nav/footer/head) comes from SiteLayout; hero markup + script
// live in HeroDemo; landing-only styles in landing.css.
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroDemo from '../components/HeroDemo.astro';
import { SITE } from '../config';
import '../styles/landing.css';

const TITLE = 'FromSukong — AI Automation | Supakone Kongprapan';
const DESCRIPTION =
  'AI automation by Supakone Kongprapan (@fromsukong) — I build systems that remove repetitive work. Hire me on Fastwork.';
---

<SiteLayout
  title={TITLE}
  description={DESCRIPTION}
  canonical={SITE + '/'}
  ogType="profile"
  jsonLd={[
    { '@type': 'ProfilePage', '@id': SITE + '/#page', url: SITE + '/', mainEntity: { '@id': SITE + '/#person' } },
  ]}
>
  <main>
    <HeroDemo />
  </main>
</SiteLayout>
