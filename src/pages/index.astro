---
// Home (Thai) — the Fastwork funnel: centered hero (headline + CTA + "about me"
// card) followed by the animated automation showcase section.
// Shell (nav/footer/head) comes from SiteLayout; hero = HeroDemo (+ HomeAbout),
// showcase = Showcase (+ its engine script); landing-only styles in landing.css.
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroDemo from '../components/HeroDemo.astro';
import Showcase from '../components/Showcase.astro';
import AuroraBackground from '../components/AuroraBackground.astro';
import { SITE } from '../config';
import '../styles/landing.css';

const TITLE = 'FromSukong — Software Engineer รับงาน AI Automation';
const DESCRIPTION =
  'Supakone Kongprapan software engineer รับงาน AI automation เช่น แชตบอท LINE ระบบถามตอบความรู้ในทีม และการเชื่อมต่อ API สั่งงานผ่าน Fastwork';
---

<SiteLayout
  title={TITLE}
  description={DESCRIPTION}
  canonical={SITE + '/'}
  ogType="profile"
  jsonLd={[
    { '@type': 'ProfilePage', '@id': SITE + '/#page', url: SITE + '/', mainEntity: { '@id': SITE + '/#person' } },
  ]}
>
  <main class="home-main">
    <AuroraBackground />
    <HeroDemo />

    <Showcase />
  </main>
</SiteLayout>
