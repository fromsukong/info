---
// Road to 85kg — Prame's public 365-day weight-loss challenge tracker.
import BackLink from '../components/BackLink.astro';

// Minimal athletic design (Strava-inspired): orange hero, hairline stats,
// route progress, scannable daily logs. Reads LIVE data from the published
// Google Sheet (gviz/tq JSON endpoint).
// Sheets ID: 1X8HKW_cZI-luydidRbb_o98umaFYEP4_nRk6xdfTO0w
const SITE = 'https://fromsukong.com';
const TITLE = 'Road to 85kg — FromSukong Challenge Tracker';
const DESCRIPTION =
  "Prame's 365-day weight-loss challenge: 104.4 kg → 85 kg. Live daily weight, workouts and food log. Follow the journey on Instagram @fromsukong.";
const GOAL = 85;
const START = 104.4;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FC5200" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={SITE + '/road-to-85kg/'} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE + '/road-to-85kg/'} />
    <meta property="og:site_name" content="FromSukong" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />

    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fustat:wght@300;400;500;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet" />

    <style is:global>
      :root { color-scheme: light; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { background: #fff; }
      body {
        font-family: 'Fustat', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: #fff; color: #18181b; line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: #fc5200; text-decoration: none; }

      /* hero */
      .hero {
        background: linear-gradient(115deg, #fc5200 0%, #e84800 55%, #c93b00 100%);
        color: #fff; padding: 78px 26px 44px;
        clip-path: polygon(0 0, 100% 0, 100% 90%, 0 100%);
      }
      .hero-inner { max-width: 480px; margin: 0 auto; }
      .kicker { font-weight: 700; font-size: 11px; letter-spacing: 2.5px; opacity: .8; text-transform: uppercase; }
      .hero h1 { font-weight: 700; font-size: 54px; line-height: .95; letter-spacing: -2px; margin: 14px 0 10px; }
      .hero h1 em { font-style: normal; color: #ffd9c7; }
      .hero .sub { font-weight: 600; font-size: 15px; opacity: .9; }

      .wrap { max-width: 480px; margin: 0 auto; padding: 0 26px 8px; }

      /* stat columns */
      .stats { display: flex; margin-top: 34px; }
      .stats .cell { flex: 1; padding: 0 18px; border-left: 1px solid #ececee; }
      .stats .cell:first-child { padding-left: 0; border-left: none; }
      .lbl { font-size: 10px; font-weight: 700; letter-spacing: 2px; color: #a1a1aa; text-transform: uppercase; margin-bottom: 6px; }
      .val { font-weight: 700; font-size: 29px; letter-spacing: -1px; line-height: 1; }
      .val small { font-size: 14px; font-weight: 700; color: #c4c4c8; }
      .val.accent { color: #fc5200; }

      /* route progress */
      .route { margin-top: 38px; }
      .route svg { width: 100%; height: 54px; display: block; }
      .routemeta { display: flex; justify-content: space-between; margin-top: 12px; font-weight: 700; font-size: 11px; color: #a1a1aa; letter-spacing: 1px; }
      .routemeta b { display: block; color: #18181b; font-size: 15px; letter-spacing: 0; margin-top: 3px; }
      .routemeta .mid { color: #fc5200; font-weight: 700; align-self: center; }

      .divider { height: 1px; background: #ececee; margin: 36px 0 10px; }

      /* section headers */
      .loghead { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
      .loghead h2, .sectitle { font-size: 12px; font-weight: 700; letter-spacing: 2px; color: #a1a1aa; text-transform: uppercase; }
      .loghead span { font-size: 12px; font-weight: 700; color: #fc5200; letter-spacing: 1px; }

      /* daily log entries */
      .entry { padding: 22px 0; border-bottom: 1px solid #f3f3f5; }
      .entry:last-of-type { border-bottom: none; }
      .entry .top { display: flex; align-items: baseline; gap: 10px; margin-bottom: 20px; }
      .entry .day { font-weight: 700; font-size: 19px; letter-spacing: -.4px; }
      .entry .date { font-size: 12.5px; font-weight: 600; color: #a1a1aa; }
      .entry .wt { margin-left: auto; font-weight: 700; font-size: 19px; color: #fc5200; letter-spacing: -.5px; }
      .delta { font-size: 11.5px; font-weight: 700; margin-left: 5px; letter-spacing: 0; }
      .delta.down { color: #059669; }
      .delta.up { color: #dc2626; }

      .tri { display: flex; }
      .tri .t { flex: 1; padding: 0 14px; border-left: 1px solid #f0f0f2; }
      .tri .t:first-child { padding-left: 0; border-left: none; }
      .tnum { font-weight: 700; font-size: 24px; letter-spacing: -.7px; line-height: 1; }
      .tunit { font-size: 12px; font-weight: 700; color: #a1a1aa; margin-left: 2px; }
      .tsum { font-size: 11px; font-weight: 700; color: #71717a; margin-top: 8px; letter-spacing: .2px; }
      .stepbar { height: 3px; background: #f0f0f2; border-radius: 99px; margin-top: 9px; overflow: hidden; }
      .stepbar i { display: block; height: 100%; background: #fc5200; border-radius: 99px; }
      .steppct { font-size: 10px; font-weight: 700; color: #fc5200; letter-spacing: 1px; margin-top: 5px; }

      .detail { display: flex; margin-top: 20px; padding-top: 16px; border-top: 1px solid #f7f7f9; }
      .detail .d { flex: 1; padding: 0 14px; border-left: 1px solid #f0f0f2; }
      .detail .d:first-child { padding-left: 0; border-left: none; }
      .dl { font-size: 10px; font-weight: 700; letter-spacing: 2px; color: #c4c4c8; text-transform: uppercase; margin-bottom: 8px; }
      .blist { list-style: none; margin: 0; padding: 0; }
      .blist li { position: relative; padding-left: 13px; font-size: 12.5px; font-weight: 600; color: #52525b; line-height: 1.75; }
      .blist li::before { content: ""; position: absolute; left: 0; top: .62em; width: 5px; height: 5px; border-radius: 99px; background: #fc8a55; }

      /* chart */
      .chartsec { margin-top: 34px; }
      .chartsec .cap { font-size: 11.5px; font-weight: 600; color: #c4c4c8; margin-top: 10px; }
      .chartsec svg { width: 100%; height: auto; display: block; margin-top: 14px; }
      .chartsec svg text { fill: #a1a1aa; font-family: 'Fustat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .5px; }

      .loading, .error { text-align: center; color: #a1a1aa; padding: 48px 0; font-size: 15px; font-weight: 600; }
      .error { color: #dc2626; }

      footer { text-align: center; font-weight: 700; font-size: 12px; color: #c4c4c8; padding: 18px 0 46px; }
      footer b { color: #fc5200; }

      /* back button: shared floating glass dot (BackLink.astro) */
      .back-link { position: fixed; top: 16px; left: 16px; z-index: 50; }
    </style>
  </head>
  <body>
    <BackLink />
    <div class="hero">
      <div class="hero-inner">
        <div class="kicker">365-Day Challenge · Ongoing</div>
        <h1>Road<br />to <em>85kg</em></h1>
        <p class="sub" id="subline">{START} kg start · Day – of 365</p>
      </div>
    </div>

    <div class="wrap">
      <div id="content"><div class="loading">Loading latest weight…</div></div>

      <footer>tracked by <b><a href="https://instagram.com/fromsukong" target="_blank" rel="noopener">@fromsukong</a></b> · <span id="updated"></span></footer>
    </div>

    <script is:inline>
      // Back button: go back in history only when the previous page is on
      // this domain; otherwise (external referrer, social app webview, fresh
      // tab) fall back to the landing page.
      (function () {
        var backEl = document.querySelector('a.back-link');
        if (!backEl) return;
        var sameDomain = false;
        try {
          if (document.referrer) {
            var ref = new URL(document.referrer);
            sameDomain = ref.hostname === location.hostname;
          }
        } catch (e) { /* malformed referrer -> treat as external */ }
        if (!(sameDomain && window.history.length > 1)) {
          backEl.addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = '/';
          });
        }
      })();

      (function () {
        const GOAL = 85, START = 104.4;
        const STEPS_GOAL = 10000, PROTEIN_GOAL = 120;
        const SHEET = 'https://docs.google.com/spreadsheets/d/1X8HKW_cZI-luydidRbb_o98umaFYEP4_nRk6xdfTO0w/gviz/tq?tqx=out:json&sheet=Log';

        function parseGviz(text) {
          const m = text.match(/setResponse\(([\s\S]*)\);?\s*$/);
          if (!m) throw new Error('bad gviz payload');
          const j = JSON.parse(m[1]);
          const rows = (j.table.rows || []).map(r => {
            const cell = (i) => r.c[i] || {};
            const fmt = (i) => (r.c[i] && r.c[i].f != null ? r.c[i].f : (cell(i).v == null ? '' : cell(i).v));
            return {
              date: fmt(0),
              day: cell(1).v,
              weight: cell(2).v,
              delta: fmt(3),
              workout: cell(4) && cell(4).v != null ? String(cell(4).v) : '',
              food: cell(5) && cell(5).v != null ? String(cell(5).v) : '',
              am: cell(6) && cell(6).v != null ? Number(cell(6).v) : null,
              steps: cell(7) && cell(7).v != null ? Number(cell(7).v) : null,
              protein: cell(8) && cell(8).v != null ? Number(cell(8).v) : null,
              water: cell(9) && cell(9).v != null ? Number(cell(9).v) : null,
              sleep: cell(10) && cell(10).v != null ? Number(cell(10).v) : null,
            };
          }).filter(r => r.date && /^\d{4}/.test(String(r.date)));
          return rows;
        }

        function esc(s) { return String(s == null ? '' : s).replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

        // Split a workout/food cell into list items (on · • or newline), strip leading "- "/"* ".
        function items(s) {
          if (!s) return [];
          return String(s)
            .split(/\s*[·•\n]\s*/)
            .map(i => i.replace(/^[-*]\s*/, '').trim())
            .filter(Boolean);
        }

        function bulleted(s) {
          const list = items(s);
          if (!list.length) return null;
          return '<ul class="blist">' + list.map(i => '<li>' + esc(i) + '</li>').join('') + '</ul>';
        }

        // Best-effort total volume: sum weight×reps across items like "Bench 50×30".
        // Items without a weight (e.g. "BW squat ×40") count as lifts but add no kg.
        function totalVolume(list) {
          let v = 0;
          list.forEach(it => {
            const m = it.match(/(\d+(?:\.\d+)?)\s*[xX×]\s*(\d+(?:\.\d+)?)/);
            if (m) v += parseFloat(m[1]) * parseFloat(m[2]);
          });
          return v;
        }

        function niceDate(iso) {
          const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
          const m = String(iso).match(/^(\d{4})-(\d{2})-(\d{2})/);
          return m ? months[Number(m[2]) - 1] + ' ' + Number(m[3]) : String(iso);
        }

        function build(rows) {
          const sorted = rows.slice().sort((a, b) => String(a.date).localeCompare(String(b.date)));
          const last = sorted[sorted.length - 1];
          const cur = last ? parseFloat(last.weight) : NaN;
          const day = last && last.day != null ? Number(last.day) : (sorted.length || 1);
          const loss = isNaN(cur) ? 0 : Math.max(0, START - cur);
          const left = isNaN(cur) ? NaN : Math.max(0, cur - GOAL);
          const pct = isNaN(cur) ? 0 : Math.min(100, ((START - cur) / (START - GOAL)) * 100);

          // hero sub line
          let sub = START + ' kg start · Day ' + day + ' of 365';
          document.getElementById('subline').textContent = sub;

          let html = '';

          // stat columns
          html += '<div class="stats">'
            + '<div class="cell"><div class="lbl">Current</div><div class="val">' + (isNaN(cur) ? '–' : cur) + '<small> kg</small></div></div>'
            + '<div class="cell"><div class="lbl">Lost</div><div class="val accent">' + loss.toFixed(1) + '<small> kg</small></div></div>'
            + '<div class="cell"><div class="lbl">Left</div><div class="val">' + (isNaN(left) ? '–' : left.toFixed(1)) + '<small> kg</small></div></div>'
            + '</div>';

          // route progress (decorative path, orange share = completion)
          const frac = Math.max(0.002, pct / 100);
          html += '<div class="route">'
            + '<svg viewBox="0 0 400 54" fill="none">'
            + '<path id="route-base" d="M4 46 C40 42 52 20 84 24 S130 50 160 40 190 8 224 14 260 42 292 32 330 6 360 12 392 26 396 23" stroke="#ECECEE" stroke-width="4" stroke-linecap="round"/>'
            + '<path d="M4 46 C40 42 52 20 84 24 S130 50 160 40 190 8 224 14 260 42 292 32 330 6 360 12 392 26 396 23" stroke="#FC5200" stroke-width="4" stroke-linecap="round" pathLength="1" stroke-dasharray="' + frac.toFixed(3) + ' 1"/>'
            + '<circle id="route-dot" r="6" fill="#FC5200"/>'
            + '</svg>'
            + '<div class="routemeta"><span>START<b>' + START + '</b></span>'
            + '<span class="mid">' + pct.toFixed(0) + '% · DAY ' + day + '/365</span>'
            + '<span style="text-align:right">GOAL<b>' + GOAL.toFixed(1) + '</b></span></div>'
            + '</div>';

          // weight trend (only with 2+ points)
          if (sorted.length >= 2) {
            const pts = sorted.filter(r => r.weight != null && !isNaN(parseFloat(r.weight)));
            if (pts.length >= 2) {
              const W = 428, H = 190, PAD = 24;
              const weights = pts.map(r => parseFloat(r.weight));
              const wmin = Math.floor(Math.min.apply(null, weights.concat([GOAL])) - 1);
              const wmax = Math.ceil(Math.max.apply(null, weights.concat([START])) + 1);
              const y = v => PAD + (wmax - v) / (wmax - wmin) * (H - PAD * 2);
              const x = i => PAD + (i / (pts.length - 1)) * (W - PAD * 2);
              let path = pts.map((r, i) => (i ? 'L' : 'M') + x(i).toFixed(1) + ',' + y(parseFloat(r.weight)).toFixed(1)).join(' ');
              const gy = y(GOAL);
              let labels = '';
              pts.forEach((r, i) => {
                if (i === 0 || i === pts.length - 1) {
                  labels += '<text x="' + x(i).toFixed(1) + '" y="' + (H - 6) + '" text-anchor="' + (i ? 'end' : 'start') + '">' + esc(niceDate(r.date)) + '</text>';
                }
              });
              html += '<div class="chartsec"><h2 class="sectitle">Weight trend</h2>'
                + '<div class="cap">' + weights[weights.length - 1].toFixed(1) + ' kg today · goal line ' + GOAL + ' kg</div>'
                + '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none">'
                + '<line x1="' + PAD + '" y1="' + gy + '" x2="' + (W - PAD) + '" y2="' + gy + '" stroke="#D9F2E5" stroke-width="1.5" stroke-dasharray="4 4"/>'
                + '<text x="' + (W - PAD) + '" y="' + (gy - 5) + '" text-anchor="end">GOAL ' + GOAL + '</text>'
                + '<path d="' + path + '" fill="none" stroke="#FC5200" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>'
                + pts.map((r, i) => '<circle cx="' + x(i).toFixed(1) + '" cy="' + y(parseFloat(r.weight)).toFixed(1) + '" r="4" fill="#FC5200"/>').join('')
                + labels
                + '</svg></div>';
            }
          }

          // daily log — most recent 14 days (newest first)
          const recent = sorted.slice(-14).reverse();
          html += '<div class="divider"></div><div class="loghead"><h2>Daily log</h2><span>LATEST</span></div>';
          html += recent.map(r => {
            const d = r.day != null ? r.day : '–';
            const wt = r.weight != null ? r.weight : '–';
            const dlNum = parseFloat(r.delta);
            const dlHtml = (r.delta !== '' && !isNaN(dlNum))
              ? '<span class="delta ' + (dlNum < 0 ? 'down' : dlNum > 0 ? 'up' : '') + '">' + (dlNum > 0 ? '▲' : dlNum < 0 ? '▼' : '') + esc(r.delta) + '</span>'
              : '';
            const wItems = items(r.workout);
            const fItems = items(r.food);
            const vol = totalVolume(wItems);

            // summary trio
            let trio = '<div class="tri">';
            if (wItems.length) {
              trio += '<div class="t"><div class="tnum">' + wItems.length + '<span class="tunit">lifts</span></div>'
                + (vol > 0 ? '<div class="tsum">~' + Math.round(vol).toLocaleString() + ' kg total volume</div>' : '') + '</div>';
            }
            if (fItems.length) {
              const pSum = (r.protein != null && !isNaN(r.protein))
                ? (r.protein >= PROTEIN_GOAL ? 'High protein ✓' : 'Protein ' + Math.round(r.protein) + 'g')
                : '';
              trio += '<div class="t"><div class="tnum">' + fItems.length + '<span class="tunit">meals</span></div>'
                + (pSum ? '<div class="tsum">' + pSum + '</div>' : '') + '</div>';
            }
            if (r.steps != null && !isNaN(r.steps) && r.steps > 0) {
              const sp = Math.min(100, (r.steps / STEPS_GOAL) * 100);
              trio += '<div class="t"><div class="tnum">' + (r.steps / 1000).toFixed(1) + '<span class="tunit">k steps</span></div>'
                + '<div class="stepbar"><i style="width:' + sp.toFixed(0) + '%"></i></div>'
                + '<div class="steppct">' + (sp >= 100 ? 'GOAL 10K · ' + Math.round(sp) + '% ✓' : Math.round(sp) + '% OF 10K') + '</div></div>';
            }
            trio += '</div>';

            // detail bullets
            let detail = '';
            const wBul = bulleted(r.workout), fBul = bulleted(r.food);
            if (wBul || fBul) {
              detail = '<div class="detail">'
                + (wBul ? '<div class="d"><div class="dl">Workout</div>' + wBul + '</div>' : '')
                + (fBul ? '<div class="d"><div class="dl">Food</div>' + fBul + '</div>' : '')
                + '</div>';
            }

            return '<div class="entry">'
              + '<div class="top"><span class="day">Day ' + esc(d) + '</span><span class="date">' + esc(niceDate(r.date)) + '</span>'
              + '<span class="wt">' + esc(wt) + ' kg' + dlHtml + '</span></div>'
              + trio + detail
              + '</div>';
          }).join('');

          document.getElementById('content').innerHTML = html;

          // place the orange dot along the route at current progress
          const base = document.getElementById('route-base');
          const dot = document.getElementById('route-dot');
          if (base && dot) {
            const L = base.getTotalLength();
            const p = base.getPointAtLength(L * frac);
            dot.setAttribute('cx', p.x); dot.setAttribute('cy', p.y);
          }

          document.getElementById('updated').textContent = last ? ('last update ' + niceDate(last.date)) : '';
        }

        function fail(msg) {
          document.getElementById('content').innerHTML =
            '<div class="error">' + esc(msg || 'Couldn\'t load data.') + '</div>';
        }

        fetch(SHEET).then(r => r.text()).then(text => {
          const rows = parseGviz(text);
          if (!rows.length) throw new Error('No data yet');
          build(rows);
        }).catch(e => fail(e.message));
      })();
    </script>
  </body>
</html>
