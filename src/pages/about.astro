---
// About — who Prame is, in the landing language: page head + white
// info cards. Shell (nav/footer/head) comes from SiteLayout.
// Section copy supports simple inline HTML: <strong>, <a href>.
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE } from '../config';

const TITLE = 'About — FromSukong | Supakone Kongprapan';
const DESCRIPTION =
  'About Supakone Kongprapan (@fromsukong) — software developer building AI automations, sharing the journey in public.';
const PAGE_URL = SITE + '/about/';

const SECTIONS = [
  {
    title: 'About',
    items: [
      'Born in 2002 in Phrae, Thailand, with a twin. Graduated Computer Engineering from Chulalongkorn University in 2025.',
      'Learned the craft at Thai startups (Genomic Analysis Platform, Api Plus Tech) and spent a summer on Work &amp; Travel in the USA in 2025.',
      'Building <strong>FromSukong</strong> and <strong>excited.live</strong> in public: daily videos, real projects, and AI automation for small businesses.',
    ],
  },
  {
    title: 'Missions & Goals',
    items: [
      'Become a great person: honest, strong, disciplined, wise, dedicated, articulate.',
      'Build or join a real technology company for Thailand.',
      'Support my family in every way by the time I am 30.',
    ],
  },
  {
    title: 'Current Focus',
    items: [
      '1. <strong>FromSukong</strong>: post at least one authentic, funny video every single day.',
      '2. <strong>excited.live</strong>: build it into a product people love.',
      '3. <a href="/road-to-85kg/">Road to 85kg</a>: lose 19.4 kg in 365 days, in public, starting from 104.4 kg.',
      '4. <strong>AI automation</strong>: build systems that remove the busywork for small businesses.',
      '5. <strong>Health</strong>: gym daily, eat well, protect sleep.',
    ],
  },
  {
    title: 'Wisdom',
    items: [
      '(I am) excited to live.',
      'Always do the hard thing smartly.',
      'Discipline gives you freedom.',
      "Be so good that they can't ignore you.",
      'Relationship is the most important thing in life.',
    ],
  },
];
---

<SiteLayout
  title={TITLE}
  description={DESCRIPTION}
  canonical={PAGE_URL}
  ogType="profile"
  jsonLd={[
    { '@type': 'ProfilePage', '@id': PAGE_URL + '#page', url: PAGE_URL, mainEntity: { '@id': SITE + '/#person' } },
  ]}
>
  <main>
    <header class="page-head">
      <span class="eyebrow"><span class="dot"></span>About</span>
      <h1 class="page-title">Supakone Kongprapan</h1>
      <p class="page-sub">(I am) an AI enthusiast.</p>
    </header>

    <div class="about-stack">
      {
        SECTIONS.map((section) => (
          <section class="info-card">
            <h2>{section.title}</h2>
            <ul class="info-list">
              {section.items.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</SiteLayout>
