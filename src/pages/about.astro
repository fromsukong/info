---
// About — the core narrative: full-time engineer building a passion project
// on the side. Page head + portrait + vertical timeline,
// then one small info card (working principles). Thai only.
// Shell (nav/footer/head) comes from SiteLayout.
// Copy supports simple inline HTML: <strong>, <a href>.
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE, FASTWORK_URL } from '../config';
import portrait from '../assets/supakone.jpg';

const TITLE = 'เกี่ยวกับ Supakone Kongprapan — AI Factory และ AI Agents';
const DESCRIPTION =
  'Supakone Kongprapan (@fromsukong) วิศวกรซอฟต์แวร์เต็มเวลา ผู้สร้าง AI factory และ agents memory และกำลังปั้นโปรเจกต์ AI วางแผนการเงินควบคู่ไปด้วย';
const PAGE_URL = SITE + '/about/';

// Timeline — read top to bottom. `when` is the label on the left rail.
// `list: true` renders the body as bullets; `now: true` highlights the card.
// Edit/add entries here; the page renders whatever is in this list.
const TIMELINE = [
  {
    when: 'ตอนนี้',
    title: 'ทำงานประจำอยู่ที่ บริษัทแอปจองโรงแรมนานาชาติ',
    list: true,
    body: [
      'เป็น 1 ใน 5 <strong>software engineer ที่ส่งงานได้เยอะที่สุด</strong> ในองค์กร',
      'ทำโปรเจกต์ <strong>Agents Memory</strong> และ <strong>AI Factory</strong> ช่วยให้ทีมทำงานร่วมกันและส่งงานได้เร็วขึ้น <strong>มากกว่า 20%</strong>',
    ],
  },
  {
    when: 'โปรเจกต์ส่วนตัว',
    title: 'ทำ opensource สำหรับวางแผนการเงิน',
    list: true,
    body: [
      'ออกแบบ <strong>แอปพลิเคชัน</strong>ที่สร้างมาเพื่อให้ <strong>agents</strong> ใช้งานโดยเฉพาะ',
      'สร้าง <strong>AI Factory</strong> ควบคุมคุณภาพของงาน AI ส่งผลให้ทำงานได้ <strong>มากกว่า 30 ชิ้น</strong> ในตอนที่หลับ',
    ],
  },
  {
    when: 'ต่อไป',
    title: 'สิ่งที่กำลังโฟกัส',
    now: true,
    list: true,
    body: [
      '<strong>ระยะสั้น:</strong> หางานฟรีแลนซ์ นำประสบการณ์จาก software engineer และความรู้เรื่อง AI มาช่วยธุรกิจจัดการหลังบ้าน (รับงานทาง <a href="' + FASTWORK_URL + '">Fastwork</a>)',
      '<strong>ระยะกลาง:</strong> ออกจากงานประจำเต็มตัว มาทุ่มกับโปรเจกต์ opensource',
    ],
  },
];

const SECTIONS = [
  {
    title: 'หลักที่ใช้ทำงาน',
    items: [
      'We can have anything, but not everything. Focus!',
      'เราไม่ได้ต้องการ AI ที่ฉลาดกว่านี้ แต่เราต้องการ AI ที่คุมได้และทำงานเป็นระบบ',
    ],
  },
];
---

<SiteLayout
  title={TITLE}
  description={DESCRIPTION}
  canonical={PAGE_URL}
  ogType="profile"
  jsonLd={[
    { '@type': 'ProfilePage', '@id': PAGE_URL + '#page', url: PAGE_URL, mainEntity: { '@id': SITE + '/#person' } },
  ]}
>
  <main>
    <header class="page-head">
      <h1 class="page-title">ศุภกร คงประพันธ์</h1>
      <p class="page-sub">วิศวกรซอฟต์แวร์มืออาชีพ หลงใหลใน AI และ Opensource</p>
      <Image
        class="about-photo"
        src={portrait}
        alt="Supakone Kongprapan"
        widths={[200, 300, 440]}
        sizes="(max-width: 480px) 160px, 200px"
        format="webp"
        quality={80}
        loading="eager"
      />
    </header>

    <ol class="timeline" aria-label="เรื่องราวของผม">
      {
        TIMELINE.map((step) => (
          <li class:list={['tl-item', { 'is-now': step.now }]}>
            <span class="tl-when">{step.when}</span>
            <span class="tl-dot" aria-hidden="true" />
            <div class="tl-card">
              <h2>{step.title}</h2>
              {step.list ? (
                <ul class="info-list">
                  {step.body.map((line) => (
                    <li set:html={line} />
                  ))}
                </ul>
              ) : (
                step.body.map((line) => <p set:html={line} />)
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="about-stack">
      {
        SECTIONS.map((section) => (
          <section class="info-card">
            <h2>{section.title}</h2>
            <ul class="info-list">
              {section.items.map((item) => (
                <li set:html={item} />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</SiteLayout>
