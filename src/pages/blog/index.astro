---
// Blog index — post cards in the landing language.
// Shell (nav/footer/head) comes from SiteLayout.
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE } from '../../config';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.pubDate.valueOf() <= Date.now())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const TITLE = 'Blog — FromSukong | Supakone Kongprapan';
const DESCRIPTION =
  'Articles on AI automation, web development and building in public by Supakone Kongprapan (@fromsukong).';

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<SiteLayout
  title={TITLE}
  description={DESCRIPTION}
  canonical={SITE + '/blog/'}
  jsonLd={[
    {
      '@type': 'Blog',
      '@id': SITE + '/blog/#blog',
      url: SITE + '/blog/',
      name: 'FromSukong Blog',
      description: DESCRIPTION,
      author: { '@id': SITE + '/#person' },
      blogPost: posts.map((post) => ({
        '@type': 'BlogPosting',
        '@id': `${SITE}/blog/${post.id}/#post`,
        url: `${SITE}/blog/${post.id}/`,
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.pubDate.toISOString(),
        author: { '@id': SITE + '/#person' },
      })),
    },
  ]}
>
  <main>
    <header class="page-head">
      <span class="eyebrow"><span class="dot"></span>Blog</span>
      <h1 class="page-title">Notes from the build</h1>
      <p class="page-sub">AI automation · web development · building in public</p>
    </header>

    <div class="posts">
      {
        posts.length === 0 ? (
          <p class="empty">No posts yet — coming soon.</p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <a class="post-card" href={`/blog/${post.id}/`}>
                  <span class="pc-main">
                    <span class="pc-title">{post.data.title}</span>
                    <span class="pc-desc">{post.data.description}</span>
                  </span>
                  <span class="pc-meta">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    <svg
                      class="pc-arrow"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 8 H13" />
                      <path d="M9 4 L13 8 L9 12" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</SiteLayout>
