---
// Blog post page — one article, prose styled for Thai + English text.
// Shell (nav/footer/head) comes from SiteLayout.
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(
    (post) => !post.data.draft && post.data.pubDate.valueOf() <= Date.now()
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const PAGE_URL = `${SITE}/blog/${post.id}/`;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<SiteLayout
  title={`${post.data.title} — FromSukong`}
  description={post.data.description}
  canonical={PAGE_URL}
  ogType="article"
  jsonLd={[
    {
      '@type': 'BlogPosting',
      '@id': PAGE_URL + '#post',
      url: PAGE_URL,
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      author: { '@id': SITE + '/#person' },
      mainEntityOfPage: PAGE_URL,
    },
  ]}
>
  <main class="post-page">
    <article>
      <header class="post-head">
        <span class="eyebrow"><span class="dot"></span>Blog</span>
        <h1>{post.data.title}</h1>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {
          post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((tag) => (
                <li>#{tag}</li>
              ))}
            </ul>
          )
        }
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</SiteLayout>
