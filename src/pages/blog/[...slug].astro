---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const SITE = 'https://fromsukong.com';
const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BlogLayout
  title={`${post.data.title} — FromSukong`}
  description={post.data.description}
  canonical={`${SITE}/blog/${post.id}/`}
  ogType="article"
>
  <main class="page post-page">
    <article>
      <header class="post-head">
        <h1>{post.data.title}</h1>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {
          post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((tag) => <li>#{tag}</li>)}
            </ul>
          )
        }
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</BlogLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `https://fromsukong.com/blog/${post.id}/#post`,
  url: `https://fromsukong.com/blog/${post.id}/`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@id': 'https://fromsukong.com/#person' },
  mainEntityOfPage: `https://fromsukong.com/blog/${post.id}/`,
})} />

<style>
  .post-page {
    padding-top: 32px;
    padding-bottom: 64px;
  }
  .post-head {
    margin: 16px 0 24px;
  }
  .post-head h1 {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 8px;
  }
  .post-head time {
    font-size: 13px;
    opacity: 0.6;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 12px 0 0;
  }
  .tags li {
    font-size: 12px;
    color: var(--color-accent);
    opacity: 0.9;
  }
  .prose {
    font-size: 16px;
    line-height: 1.7;
  }
  .prose h2 {
    font-size: 22px;
    margin: 32px 0 12px;
  }
  .prose h3 {
    font-size: 18px;
    margin: 24px 0 8px;
  }
  .prose p {
    margin: 0 0 16px;
  }
  .prose a {
    color: var(--color-accent);
  }
  .prose code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    background: rgba(245, 246, 247, 0.08);
    padding: 2px 6px;
    border-radius: 6px;
  }
  .prose pre {
    background: #0a0a0a;
    border: 1px solid rgba(245, 246, 247, 0.1);
    border-radius: 12px;
    padding: 16px;
    overflow-x: auto;
    margin: 0 0 16px;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose img {
    max-width: 100%;
    border-radius: 12px;
  }
  .prose blockquote {
    margin: 0 0 16px;
    padding-left: 16px;
    border-left: 3px solid var(--color-accent);
    opacity: 0.85;
  }
</style>
