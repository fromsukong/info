---
// Site nav pill + mobile sidebar drawer (2026-09-27).
// Desktop: avatar brand + inline Blog/About links + "Hire me".
// ≤860px: the avatar is replaced by a menu button; tapping it opens the
// drawer (Blog / About / Demo + Fastwork CTA). Styles live in site.css.
// Used by every page through SiteLayout.
import { FASTWORK_URL } from '../config';
const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const path = normalize(Astro.url.pathname);
const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/demo/', label: 'Demo' },
];
const isCurrent = (href: string) => {
  const normHref = normalize(href);
  return path === normHref || path.startsWith(normHref + '/');
};
---

<nav class="nav-wrap" aria-label="Main">
  <div class="nav-pill">
    <div class="nav-left">
      <button
        class="nav-menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path></svg>
      </button>
      <a class="nav-brand" href="/">
        <img src="/assets/avatar.png" alt="" width="30" height="30" />
        <span>fromsukong<span class="brand-dot">.com</span></span>
      </a>
    </div>
    <div class="nav-links">
      {links.slice(0, 2).map((l) => (
        <a href={l.href} class:list={{ 'is-current': isCurrent(l.href) }} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
    <div class="nav-actions">
      <a class="btn-ink" href={FASTWORK_URL} target="_blank" rel="noopener">Hire me</a>
    </div>
  </div>
</nav>

<div class="nav-backdrop" aria-hidden="true"></div>

<aside class="nav-drawer" id="nav-drawer" aria-label="Site menu" aria-hidden="true" inert>
  <div class="nav-drawer-head">
    <a class="drawer-brand" href="/">
      <img src="/assets/avatar.png" alt="" width="34" height="34" />
      <span>fromsukong<span class="brand-dot">.com</span></span>
    </a>
    <button class="nav-drawer-close" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg>
    </button>
  </div>
  <nav class="nav-drawer-links" aria-label="Menu">
    {links.map((l) => (
      <a href={l.href} class:list={{ 'is-current': isCurrent(l.href) }} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <div class="nav-drawer-foot">
    <a class="btn-ink" href={FASTWORK_URL} target="_blank" rel="noopener">Hire me on Fastwork</a>
  </div>
</aside>

<script is:inline>
  // Mobile sidebar drawer: open from the nav menu button (≤860px).
  (function () {
    var btn = document.querySelector('.nav-menu-btn');
    var drawer = document.getElementById('nav-drawer');
    var backdrop = document.querySelector('.nav-backdrop');
    if (!btn || !drawer) return;
    var closeBtn = drawer.querySelector('.nav-drawer-close');
    var isOpen = false;

    function setOpen(next, focusBtn) {
      if (isOpen === next) return;
      isOpen = next;
      btn.setAttribute('aria-expanded', next ? 'true' : 'false');
      drawer.classList.toggle('is-open', next);
      if (backdrop) backdrop.classList.toggle('is-open', next);
      document.documentElement.classList.toggle('nav-open', next);
      if (next) {
        drawer.removeAttribute('inert');
        drawer.setAttribute('aria-hidden', 'false');
        requestAnimationFrame(function () { if (closeBtn) closeBtn.focus(); });
      } else {
        drawer.setAttribute('inert', '');
        drawer.setAttribute('aria-hidden', 'true');
        if (focusBtn) btn.focus();
      }
    }

    function getFocusables() {
      return drawer.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])');
    }

    btn.addEventListener('click', function () { setOpen(!isOpen); });
    if (closeBtn) closeBtn.addEventListener('click', function () { setOpen(false, true); });
    if (backdrop) backdrop.addEventListener('click', function () { setOpen(false, true); });
    document.addEventListener('keydown', function (e) {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        setOpen(false, true);
        return;
      }
      if (e.key === 'Tab') {
        var focusables = getFocusables();
        if (!focusables.length) return;
        var first = focusables[0];
        var last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });

    // Close automatically if the viewport grows past the mobile breakpoint.
    var mq = window.matchMedia('(min-width: 861px)');
    var onChange = function () { if (mq.matches && isOpen) setOpen(false); };
    if (mq.addEventListener) mq.addEventListener('change', onChange);
    else if (mq.addListener) mq.addListener(onChange);
  })();
</script>
