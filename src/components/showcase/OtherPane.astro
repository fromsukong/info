---
// Showcase pane: "something else? let's talk" — idea chips + Fastwork CTA.

const steps = [
  [300, 'i1'], [800, 'i2'], [1300, 'i3'], [1800, 'i4'], [2400, 'i5'], [3200, 'head'], [3700, 'sub'], [4300, 'cta'], [5200, '~cta'], [6900, '~-cta'],
];
const ideas = ['สรุปรายงานอัตโนมัติ', 'ตอบอีเมลลูกค้า', 'ทำใบเสนอราคา', 'ดึงข้อมูลจากเว็บ'];
---

<div class="demo-tabpane oth" id="pane-other" role="tabpanel" aria-labelledby="tab-other" data-pane="other" data-steps={JSON.stringify(steps)}>
  <ul class="ot-ideas">
    {ideas.map((t, i) => <li class="ot-chip" data-a={`i${i + 1}`}><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M7 2.5 V11.5 M2.5 7 H11.5"></path></svg>{t}</li>)}
    <li class="ot-chip ot-more" data-a="i5">อื่น ๆ ที่คุณนึกอยู่…</li>
  </ul>

  <div class="ot-card">
    <h3 class="ot-head" data-a="head">ไอเดียของคุณไม่อยู่ในนี้? คุยกันก่อนได้</h3>
    <p class="ot-sub" data-a="sub">เล่างานที่กินเวลาคุณอยู่ ผมช่วยดูว่าทำอัตโนมัติได้ไหม</p>
    <p class="ot-fly" data-a="cta" data-fly-to=".nav-cta">
      <svg class="ot-fly-ic" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 11.5 V2.5"></path><path d="M3.5 6 L7 2.5 L10.5 6"></path></svg>
      กดปุ่ม “จ้างผม” ด้านบนได้เลย
    </p>
  </div>
</div>

<style>
  .ot-ideas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .ot-chip {
    display: inline-flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 600; color: var(--charcoal);
    background: var(--white); border: 1.5px solid var(--ghost); border-radius: 999px; padding: 9px 16px;
    box-shadow: var(--shadow-card);
    opacity: 0; transform: translateY(8px) scale(0.94); transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ot-chip svg { width: 12px; height: 12px; color: var(--orange); flex: none; }
  .ot-chip.on { opacity: 1; transform: none; }
  .ot-more { border-style: dashed; border-color: color-mix(in srgb, var(--orange) 55%, transparent); color: var(--orange); box-shadow: none; }

  .ot-card {
    background: var(--canvas); border: 1px solid var(--ghost); border-radius: 28px; padding: 26px 22px;
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px;
  }
  .ot-head { margin: 0; font-size: clamp(19px, 5vw, 24px); line-height: 1.35; color: var(--ink); font-weight: 600; letter-spacing: -0.3px; text-wrap: balance; }
  .ot-sub { margin: 0 0 8px; font-size: 14.5px; line-height: 1.6; color: var(--slate); max-width: 420px; text-wrap: balance; }
  .ot-head, .ot-sub { opacity: 0; transform: translateY(8px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .ot-head.on, .ot-sub.on { opacity: 1; transform: none; }
  .ot-fly {
    margin: 4px 0 0; display: inline-flex; align-items: center; gap: 8px;
    font-size: 15px; font-weight: 600; color: var(--ink);
    background: var(--white); border: 1.5px solid var(--ghost); border-radius: 999px; padding: 10px 20px;
    opacity: 0; transform: translateY(8px) scale(0.96); transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .ot-fly.on { opacity: 1; transform: none; }
  .ot-fly-ic { width: 14px; height: 14px; flex: none; color: var(--orange); transform: rotate(180deg); /* head-down from the start — the flying arrow launches from this pose */ transition: opacity 0.15s ease; }
  .ot-fly.pulse .ot-fly-ic { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .ot-chip, .ot-head, .ot-sub, .ot-fly { transition: none; }
  }
</style>
