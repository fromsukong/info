---
// Showcase pane: automated API connector / data sync (shop -> accounting sheet).
const steps = [
  [300, '~src'], [900, 'pay'], [1700, 'send'], [1700, 'dot'], [2700, '-pay'], [2700, '-dot'], [2700, '~-src'],
  [2800, 'r1'], [3100, 'r2'], [3400, 'r3'], [4100, 'tag'],
];
---

<div class="demo-tabpane api" id="pane-api" role="tabpanel" aria-labelledby="tab-api" data-pane="api" data-loop="8000" data-steps={JSON.stringify(steps)}>
  <div class="ap-strip">
    <div class="ap-card">
      <div class="ap-ico"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3.5 H4.5 L6 12.5 H15 L16.5 6.5 H5"></path><circle cx="7.5" cy="16" r="1.2"></circle><circle cx="14" cy="16" r="1.2"></circle></svg></div>
      <b>ร้านค้าออนไลน์</b>
      <span class="ap-sub">ออเดอร์ใหม่ <em class="ap-badge" data-a="src">3</em></span>
    </div>

    <div class="ap-link" aria-hidden="true">
      <span class="ap-line"></span>
      <svg class="ap-arrow" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 1 L7 5 L2 9"></path></svg>
      <i class="ap-dot" data-a="dot" data-transient></i>
    </div>

    <div class="ap-card ap-target">
      <div class="ap-ico"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="2.5"></rect><path d="M3 8 H17 M8 8 V17"></path></svg></div>
      <b>ระบบบัญชี</b>
      <span class="ap-sub">Google Sheets</span>
      <div class="ap-table" role="table" aria-label="รายการที่ซิงก์แล้ว">
        <div class="ap-row" data-a="r1"><span>#1042</span><span>฿1,290</span><i>✓</i></div>
        <div class="ap-row" data-a="r2"><span>#1043</span><span>฿640</span><i>✓</i></div>
        <div class="ap-row" data-a="r3"><span>#1044</span><span>฿2,150</span><i>✓</i></div>
      </div>
    </div>
  </div>

  <div class="ap-lane" data-a="pay" data-transient aria-hidden="true">
    <pre class="ap-pay" data-a="send"><code set:text={'POST /sync\n{"id":1042,"total":1290}'}></code></pre>
  </div>

  <div class="ap-tag" data-a="tag">
    <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7.5 L5.8 10.5 L11.5 3.5"></path></svg>
    ซิงก์ 128 รายการ ใน 2.4 วินาที · ไม่ต้องคีย์เอง
  </div>
</div>

<style>
  .ap-strip { display: grid; grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1.25fr); align-items: center; }
  @media (min-width: 560px) { .ap-strip { grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1.25fr); } }
  .ap-card {
    background: var(--white); border: 1px solid var(--ghost); border-radius: 24px; box-shadow: var(--shadow-card);
    padding: 16px; display: flex; flex-direction: column; gap: 4px; min-width: 0; align-self: stretch;
  }
  .ap-card b { font-size: 14.5px; color: var(--ink); line-height: 1.35; }
  .ap-sub { font-size: 12.5px; color: var(--slate); display: inline-flex; align-items: center; gap: 6px; }
  .ap-ico { width: 34px; height: 34px; border-radius: 12px; background: var(--canvas); color: var(--orange); display: grid; place-items: center; margin-bottom: 6px; }
  .ap-ico svg { width: 18px; height: 18px; }
  .ap-badge { font-style: normal; font-size: 11px; font-weight: 700; background: var(--orange); color: var(--white); border-radius: 999px; padding: 1px 7px; transition: transform 0.4s ease; }
  .ap-badge.pulse { transform: scale(1.25); }

  .ap-link { position: relative; height: 20px; color: var(--dust); }
  .ap-line { position: absolute; left: 4px; right: 8px; top: 50%; border-top: 2px dashed currentColor; }
  .ap-arrow { position: absolute; right: 2px; top: 50%; width: 10px; height: 10px; margin-top: -5px; }
  .ap-dot { position: absolute; top: 50%; left: 0; width: 10px; height: 10px; margin: -5px 0 0; border-radius: 50%; background: var(--orange); opacity: 0; }
  .ap-dot.on { opacity: 1; left: calc(100% - 12px); transition: left 0.9s ease-in-out, opacity 0.2s ease; }

  .ap-table { margin-top: 8px; display: flex; flex-direction: column; gap: 5px; }
  .ap-row {
    display: grid; grid-template-columns: 1fr auto 16px; gap: 8px; align-items: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Noto Sans Thai', monospace; font-size: 12px; color: var(--charcoal);
    background: var(--canvas); border-radius: 10px; padding: 5px 9px;
    opacity: 0; transform: translateY(6px); transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .ap-row i { font-style: normal; font-weight: 700; color: var(--orange); }
  .ap-row.on { opacity: 1; transform: none; }

  .ap-lane { display: flex; opacity: 0; transition: opacity 0.4s ease; }
  .ap-lane.on { opacity: 1; }
  .ap-pay {
    margin: 0; width: 72%; box-sizing: border-box; overflow: hidden; white-space: pre;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Noto Sans Thai', monospace; font-size: 11px; line-height: 1.5;
    background: var(--ink); color: var(--canvas); border-radius: 16px; padding: 9px 12px; box-shadow: var(--shadow-card);
    transition: transform 0.9s ease-in-out;
  }
  .ap-pay.on { transform: translateX(38.9%); }

  .ap-tag {
    display: flex; align-items: center; justify-content: center; gap: 8px; text-align: center;
    font-size: 13.5px; font-weight: 600; color: var(--slate);
    opacity: 0; transform: translateY(6px); transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .ap-tag.on { opacity: 1; transform: none; }
  .ap-tag svg { width: 13px; height: 13px; flex: none; color: var(--orange); }

  @media (prefers-reduced-motion: reduce) {
    .ap-row, .ap-tag, .ap-badge, .ap-dot.on, .ap-pay, .ap-lane { transition: none; }
  }
</style>
