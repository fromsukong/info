---
// Aurora background for the top of the home page (a band behind the navbar).
// Faithful vanilla port of "Aurora" from Svelte Bits (David Haz, MIT + Commons Clause),
// https://sveltebits.xyz/backgrounds/aurora — same OGL fragment shader
// (simplex-noise height field + 3-stop colour ramp), same uniforms:
// colorStops, amplitude, blend, speed. Svelte runes replaced by plain JS.
//
// Behaviour: ogl is loaded lazily (dynamic import → its own chunk) once the
// hero is visible; rendering pauses offscreen / on hidden tab; reduced-motion
// and no-WebGL keep the static CSS gradient below. Cheaper on mobile
// (DPR 1, 30 fps).
interface Props {
  colorStops?: [string, string, string];
  amplitude?: number;
  blend?: number;
  speed?: number;
}
// Warm stops tuned for the cream canvas: orange → peach → sand (lightened: the shader multiplies colour by intensity, which darkens on cream).
const {
  colorStops = ['#FF9A5C', '#FFC49A', '#FBE3BE'],
  amplitude = 0.9,
  blend = 0.6,
  speed = 0.8,
} = Astro.props;
---

<div
  class="aurora"
  aria-hidden="true"
  data-stops={colorStops.join(',')}
  data-amplitude={amplitude}
  data-blend={blend}
  data-speed={speed}
>
</div>

<style>
  /* A band at the very top of main.home-main: starts behind the sticky nav
     pill (top: -96px ≈ nav height) and fades out downward so it melts into
     the canvas. Static gradient = fallback (reduced motion / no WebGL)
     and the loading state, replaced by the canvas once it renders. */
  .aurora {
    position: absolute;
    top: -96px;
    left: 0;
    right: 0;
    height: clamp(380px, 46vw, 520px);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(60% 55% at 20% 0%, rgba(243, 115, 56, 0.34), transparent 70%),
      radial-gradient(55% 50% at 80% 0%, rgba(244, 168, 119, 0.4), transparent 70%),
      radial-gradient(50% 40% at 50% 0%, rgba(235, 207, 166, 0.5), transparent 75%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
  }
  .aurora :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .aurora[data-ready] { background: none; }
  .aurora[data-ready] :global(canvas) { opacity: 0.85; }
</style>

<script>
  const VERT = `#version 300 es
in vec2 position;
void main() {
  gl_Position = vec4(position, 0.0, 1.0);
}
`;

  const FRAG = `#version 300 es
precision highp float;

uniform float uTime;
uniform float uAmplitude;
uniform vec3 uColorStops[3];
uniform vec2 uResolution;
uniform float uBlend;

out vec4 fragColor;

vec3 permute(vec3 x) {
  return mod(((x * 34.0) + 1.0) * x, 289.0);
}

float snoise(vec2 v){
  const vec4 C = vec4(
      0.211324865405187, 0.366025403784439,
      -0.577350269189626, 0.024390243902439
  );
  vec2 i  = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod(i, 289.0);

  vec3 p = permute(
      permute(i.y + vec3(0.0, i1.y, 1.0))
    + i.x + vec3(0.0, i1.x, 1.0)
  );

  vec3 m = max(
      0.5 - vec3(
          dot(x0, x0),
          dot(x12.xy, x12.xy),
          dot(x12.zw, x12.zw)
      ),
      0.0
  );
  m = m * m;
  m = m * m;

  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);

  vec3 g;
  g.x  = a0.x  * x0.x  + h.x  * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

struct ColorStop {
  vec3 color;
  float position;
};

#define COLOR_RAMP(colors, factor, finalColor) {              \\
  int index = 0;                                            \\
  for (int i = 0; i < 2; i++) {                               \\
     ColorStop currentColor = colors[i];                    \\
     bool isInBetween = currentColor.position <= factor;    \\
     index = int(mix(float(index), float(i), float(isInBetween))); \\
  }                                                         \\
  ColorStop currentColor = colors[index];                   \\
  ColorStop nextColor = colors[index + 1];                  \\
  float range = nextColor.position - currentColor.position; \\
  float lerpFactor = (factor - currentColor.position) / range; \\
  finalColor = mix(currentColor.color, nextColor.color, lerpFactor); \\
}

void main() {
  vec2 uv = gl_FragCoord.xy / uResolution;

  ColorStop colors[3];
  colors[0] = ColorStop(uColorStops[0], 0.0);
  colors[1] = ColorStop(uColorStops[1], 0.5);
  colors[2] = ColorStop(uColorStops[2], 1.0);

  vec3 rampColor;
  COLOR_RAMP(colors, uv.x, rampColor);

  float height = snoise(vec2(uv.x * 2.0 + uTime * 0.1, uTime * 0.25)) * 0.5 * uAmplitude;
  height = exp(height);
  height = (uv.y * 2.0 - height + 0.2);
  float intensity = 0.6 * height;

  float midPoint = 0.20;
  float auroraAlpha = smoothstep(midPoint - uBlend * 0.5, midPoint + uBlend * 0.5, intensity);

  // Light-canvas tweak: upstream is intensity * rampColor (built for dark bg), which
  // reads as muddy brown over cream. Keep most of the colour, a little of the falloff.
  vec3 auroraColor = rampColor * (0.8 + 0.2 * clamp(intensity, 0.0, 1.0));

  fragColor = vec4(auroraColor * auroraAlpha, auroraAlpha);
}
`;

  const root = document.querySelector<HTMLElement>('.aurora');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root && !reduce.matches && 'IntersectionObserver' in window) {
    const stops = (root.dataset.stops || '').split(',');
    const amplitude = parseFloat(root.dataset.amplitude || '1');
    const blend = parseFloat(root.dataset.blend || '0.5');
    const speed = parseFloat(root.dataset.speed || '1');
    const mobile = window.matchMedia('(max-width: 960px)');

    let started = false;
    let visible = false;
    let setRunning: (on: boolean) => void = () => {};

    const start = async () => {
      started = true;
      try {
        const { Renderer, Program, Mesh, Color, Triangle } = await import('ogl');
        const renderer = new Renderer({
          alpha: true,
          premultipliedAlpha: true,
          antialias: false, // full-bleed soft gradient: AA is wasted fill-rate
          dpr: mobile.matches ? 1 : Math.min(window.devicePixelRatio || 1, 1.5),
        });
        const gl = renderer.gl;
        if (!gl || !(gl instanceof WebGL2RenderingContext)) return;
        gl.clearColor(0, 0, 0, 0);
        gl.enable(gl.BLEND);
        gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

        const geometry = new Triangle(gl);
        // Shader doesn't use uv (mirrors upstream).
        delete (geometry.attributes as Record<string, unknown>).uv;

        const program = new Program(gl, {
          vertex: VERT,
          fragment: FRAG,
          uniforms: {
            uTime: { value: 0 },
            uAmplitude: { value: amplitude },
            uColorStops: { value: stops.map((hex) => { const c = new Color(hex); return [c.r, c.g, c.b]; }) },
            uResolution: { value: [root.offsetWidth, root.offsetHeight] },
            uBlend: { value: blend },
          },
        });
        if (!gl.getProgramParameter(program.program, gl.LINK_STATUS)) return;

        const mesh = new Mesh(gl, { geometry, program });
        root.appendChild(gl.canvas as HTMLCanvasElement);

        const resize = () => {
          const w = root.offsetWidth;
          const h = root.offsetHeight;
          if (!w || !h) return;
          renderer.dpr = mobile.matches ? 1 : Math.min(window.devicePixelRatio || 1, 1.5);
          renderer.setSize(w, h);
          program.uniforms.uResolution.value = [gl.canvas.width, gl.canvas.height];
        };
        new ResizeObserver(resize).observe(root);
        resize();

        // Upstream: time = rAF ms * 0.01, uTime = time * speed * 0.1. We
        // accumulate elapsed ms so pausing offscreen doesn't make it jump.
        let raf = 0;
        let last = 0;
        let clock = 0;
        let lastDraw = 0;
        const frame = (now: number) => {
          raf = requestAnimationFrame(frame);
          if (mobile.matches && now - lastDraw < 33) return; // ~30 fps on mobile
          lastDraw = now;
          clock += Math.min(now - last, 100);
          last = now;
          program.uniforms.uTime.value = clock * 0.01 * speed * 0.1;
          renderer.render({ scene: mesh });
        };
        setRunning = (on) => {
          cancelAnimationFrame(raf);
          raf = 0;
          if (on) {
            last = performance.now();
            raf = requestAnimationFrame(frame);
          }
        };
        renderer.render({ scene: mesh });
        root.setAttribute('data-ready', '');
        setRunning(visible && !document.hidden);

        gl.canvas.addEventListener('webglcontextlost', (e) => {
          e.preventDefault();
          setRunning(false);
          root.removeAttribute('data-ready');
        });
      } catch {
        /* no WebGL2 / ogl failed: the CSS gradient stays */
      }
    };

    const sync = () => setRunning(visible && !document.hidden && !reduce.matches);
    new IntersectionObserver((entries) => {
      visible = entries[entries.length - 1].isIntersecting;
      if (visible && !started) start();
      else sync();
    }).observe(root);
    document.addEventListener('visibilitychange', sync);
    reduce.addEventListener('change', sync);
  }
</script>
