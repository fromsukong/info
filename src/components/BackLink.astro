---
// Small back button shown on non-landing pages (iOS-style chevron only).
// Goes BACK in history when possible (Prame 2026-08-13: "make it actually go back,
// no always go to home"), falls back to home on a fresh tab.
---

<a href="/" class="back-link" aria-label="Back to home" data-umami-event="back-home">
  <span class="back-btn">
    <svg class="back-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  </span>
</a>

<script is:inline>
  const backEl = document.querySelector('a.back-link');
  if (backEl) {
    backEl.addEventListener('click', (e) => {
      if (window.history.length > 1) {
        e.preventDefault();
        window.history.back();
      }
    });
  }
</script>
