---
// Small back button shown on non-landing pages — floating round glass dot,
// fixed top-left. Goes BACK in history when the previous page is on this
// domain; otherwise (social-app webview, external referrer, fresh tab) it
// falls back to the landing page.
// Reused by: about page, blog layout, road-to-85kg.
---

<a href="/" class="back-link" aria-label="Back to home" data-umami-event="back-home">
  <span class="back-btn">
    <svg class="back-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  </span>
</a>

<style is:global>
  /* Floating round back button — sits over whatever is at the top of the page */
  .back-link {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 50;
    text-decoration: none;
  }
  .back-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(30, 12, 4, 0.34);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #fff;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.28),
      0 1px 6px rgba(24, 24, 27, 0.16);
    transition: background 0.15s ease;
  }
  .back-chevron {
    width: 18px;
    height: 18px;
  }
  .back-link:hover .back-btn {
    background: rgba(30, 12, 4, 0.32);
  }
</style>

<script is:inline>
  (function () {
    var backEl = document.querySelector('a.back-link');
    if (!backEl) return;
    var sameDomain = false;
    try {
      if (document.referrer) {
        sameDomain = new URL(document.referrer).hostname === location.hostname;
      }
    } catch (e) { /* malformed referrer -> treat as external */ }
    backEl.addEventListener('click', function (e) {
      e.preventDefault();
      if (sameDomain && window.history.length > 1) {
        // Previous entry belongs to this site -> really go BACK in history.
        // Never pushes a new entry, so the browser-back button afterwards
        // keeps exiting the site instead of bouncing into the page we left.
        window.history.back();
      } else {
        // Arrived here directly (social webview, shared link, fresh tab):
        // REPLACE this subpage with the landing page so the history stack
        // behaves as if the visitor had been on "/" all along.
        window.location.replace('/');
      }
    });
  })();
</script>
