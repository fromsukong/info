---
// Small back-to-home button shown on non-landing pages (iOS-style chevron only).
---

<a href="/" class="back-link" aria-label="Back to home" data-umami-event="back-home">
  <span class="back-btn">
    <svg class="back-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6" />
    </svg>
  </span>
</a>
